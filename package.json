{
    "name": "datacanvas",
    "version": "1.0.0",
    "description": "Adobe Creative Cloud Web Add-on.",
    "scripts": {
        "clean": "ccweb-add-on-scripts clean",
        "build": "ccweb-add-on-scripts build --use webpack",
        "start": "ccweb-add-on-scripts start --use webpack",
        "package": "ccweb-add-on-scripts package --use webpack",
        "test": "tsx --test test/*.test.ts",
        "assets:generate": "python3 scripts/generate-submission-assets.py",
        "release:check": "npm test && npm run package && node scripts/validate-release.mjs"
    },
    "keywords": [
        "Adobe",
        "Creative Cloud Web",
        "Add-on",
        "panel"
    ],
    "dependencies": {
        "@swc-react/button": "1.7.0",
        "@swc-react/theme": "1.7.0",
        "react": "18.2.0",
        "react-dom": "18.2.0"
    },
    "devDependencies": {
        "@adobe/ccweb-add-on-scripts": "^3.11.0",
        "@types/adobe__ccweb-add-on-sdk": "^1.3.0",
        "@types/react": "18.2.21",
        "@types/react-dom": "18.2.7",
        "copy-webpack-plugin": "11.0.0",
        "css-loader": "6.8.1",
        "html-webpack-plugin": "5.5.3",
        "style-loader": "3.3.3",
        "ts-loader": "9.5.1",
        "tsx": "^4.20.6",
        "typescript": "5.3.2",
        "webpack": "^5.112.2",
        "webpack-cli": "6.0.1"
    }
}
